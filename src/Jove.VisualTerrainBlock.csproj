<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Jove.VisualTerrainBlock</AssemblyName>
    <RootNamespace>Jove.VisualTerrainBlock</RootNamespace>
    <Version>0.1.2</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <TimberbornManaged Condition="'$(TimberbornManaged)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/common/Timberborn/Timberborn.app/Contents/Resources/Data/Managed</TimberbornManaged>
    <HarmonyDll Condition="'$(HarmonyDll)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/workshop/content/1062090/3284904751/0Harmony.dll</HarmonyDll>
    <ModInstallDir Condition="'$(ModInstallDir)' == ''">$(HOME)/Documents/Timberborn/Mods/VisualTerrainBlock</ModInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Timberborn.BaseComponentSystem">
      <HintPath>$(TimberbornManaged)/Timberborn.BaseComponentSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Timberborn.BlueprintSystem">
      <HintPath>$(TimberbornManaged)/Timberborn.BlueprintSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Timberborn.EntitySystem">
      <HintPath>$(TimberbornManaged)/Timberborn.EntitySystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Timberborn.BlockSystem">
      <HintPath>$(TimberbornManaged)/Timberborn.BlockSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Timberborn.Common">
      <HintPath>$(TimberbornManaged)/Timberborn.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Timberborn.SingletonSystem">
      <HintPath>$(TimberbornManaged)/Timberborn.SingletonSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Bindito.Core">
      <HintPath>$(TimberbornManaged)/Bindito.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(TimberbornManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Harmony 由 workshop 的 Harmony mod 提供，不随本 mod 分发 -->
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToGameMod" AfterTargets="Build">
    <MakeDir Directories="$(ModInstallDir)/Scripts" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModInstallDir)/Scripts" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)/../Scripts" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../manifest.json" DestinationFolder="$(ModInstallDir)" />
  </Target>

</Project>
